{
  "name": "@nicator/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./env": "./src/env.ts",
    "./test-factories": "./src/test-factories.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
