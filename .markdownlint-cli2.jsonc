{
  "config": {
    // Line length — disabled; prose paragraphs wrap naturally
    "MD013": false,
    // Allow duplicate headings in different sections (e.g. "What it is not" repeated per entity)
    "MD024": { "siblings_only": true },
    // Allow inline HTML (mermaid styling, etc.)
    "MD033": false,
    // Allow bare URLs — common in docs
    "MD034": false,
    // Table column alignment — disabled; prettier owns table formatting
    "MD060": false
  },
  "globs": ["**/*.md"],
  "ignores": ["node_modules", "**/node_modules", "dist", "**/dist", "evals/results"]
}
