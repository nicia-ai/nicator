# Required
ANTHROPIC_API_KEY=sk-ant-...

# Optional — if absent, skills/web-search returns mock responses
BRAVE_API_KEY=BSA...

# Optional — override the default harness model (default: claude-sonnet-4-5)
# HARNESS_MODEL=claude-sonnet-4-5

# Optional — override the eval judge model (default: claude-opus-4-5)
# EVAL_JUDGE_MODEL=claude-opus-4-5
