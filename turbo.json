{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format:check": {},
    "fix": {
      "cache": false
    },
    "check": {
      "dependsOn": ["typecheck", "lint", "format:check"]
    },
    "test": {
      "dependsOn": ["^build"],
      "cache": false
    }
  }
}
